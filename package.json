{
  "name": "single-company-store",
  "private": true,
  "workspaces": [
    "backend",
    "frontend_user",
    "frontend_dashboard"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:storefront\" \"npm run dev:admin\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:storefront": "npm run dev --workspace frontend_user",
    "dev:admin": "npm run dev --workspace frontend_dashboard",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "supabase": "^2.118.0"
  }
}